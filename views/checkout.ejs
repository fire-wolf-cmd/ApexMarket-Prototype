<%- include('header') %>

<div class="container mt-40">
    <div style="max-width:800px; margin:0 auto;">
        <h1 style="font-size:2rem; margin-bottom:40px; text-align:center; color:var(--ruby-pink);">Checkout</h1>
        
        <div class="checkout-step active" id="step-1">
            <div style="background:white; border-radius:15px; box-shadow:var(--shadow); margin-bottom:20px; overflow:hidden;">
                <div style="padding:20px 30px; background:var(--soft-pink); display:flex; justify-content:space-between; align-items:center;">
                    <div style="display:flex; align-items:center; gap:15px;">
                        <span style="background:var(--ruby-pink); color:white; width:25px; height:25px; border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:0.8rem; font-weight:700;">1</span>
                        <h2 style="font-size:1.1rem;">LOGIN OR SIGNUP</h2>
                    </div>
                </div>
                <div style="padding:30px;" id="step-1-content">
                    <p style="font-weight:600;">Verified Customer: 0123456789</p>
                    <button class="btn btn-primary mt-40" onclick="nextStep(2)">CONTINUE TO ADDRESS</button>
                </div>
            </div>
        </div>

        <div class="checkout-step" id="step-2">
            <div style="background:white; border-radius:15px; box-shadow:var(--shadow); margin-bottom:20px; overflow:hidden;">
                <div style="padding:20px 30px; background:var(--white); border-bottom:1px solid #eee; display:flex; align-items:center; gap:15px;">
                    <span style="background:#ccc; color:white; width:25px; height:25px; border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:0.8rem; font-weight:700;" id="step-2-num">2</span>
                    <h2 style="font-size:1.1rem; color:#666;" id="step-2-title">DELIVERY ADDRESS</h2>
                </div>
                <div style="padding:30px; display:none;" id="step-2-content">
                    <div style="border:2px solid var(--ruby-pink); border-radius:12px; padding:20px; background:var(--soft-pink); margin-bottom:20px;">
                        <p style="font-weight:700;">Jane Doe</p>
                        <p style="color:var(--light-text);">123, Pink Tower, Bengaluru, 560001</p>
                        <button class="btn btn-primary mt-40" onclick="nextStep(3)">DELIVER HERE</button>
                    </div>
                </div>
            </div>
        </div>

        <div class="checkout-step" id="step-3">
            <div style="background:white; border-radius:15px; box-shadow:var(--shadow); margin-bottom:20px; overflow:hidden;">
                <div style="padding:20px 30px; background:var(--white); border-bottom:1px solid #eee; display:flex; align-items:center; gap:15px;">
                    <span style="background:#ccc; color:white; width:25px; height:25px; border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:0.8rem; font-weight:700;" id="step-3-num">3</span>
                    <h2 style="font-size:1.1rem; color:#666;" id="step-3-title">PAYMENT OPTIONS</h2>
                </div>
                <div style="padding:30px; display:none;" id="step-3-content">
                    <div style="display:flex; flex-direction:column; gap:15px; margin-bottom:30px;">
                        <label class="payment-label" style="padding:15px; border:2px solid var(--ruby-pink); background:var(--soft-pink); border-radius:10px; display:flex; gap:10px; cursor:pointer;" onclick="selectPayment(this)">
                            <input type="radio" name="pay" checked> PhonePe / GPay
                        </label>
                        <label class="payment-label" style="padding:15px; border:1px solid #eee; border-radius:10px; display:flex; gap:10px; cursor:pointer;" onclick="selectPayment(this)">
                            <input type="radio" name="pay"> Net Banking
                        </label>
                        <label class="payment-label" style="padding:15px; border:1px solid #eee; border-radius:10px; display:flex; gap:10px; cursor:pointer;" onclick="selectPayment(this)">
                            <input type="radio" name="pay"> Cash on Delivery
                        </label>
                    </div>
                    <button class="btn btn-primary" style="width:100%; padding:18px;" onclick="placeOrder()">PLACE ORDER & PAY</button>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
function nextStep(step) {
    for(let i=1; i<=3; i++) {
        const content = document.getElementById(`step-${i}-content`);
        if (content) content.style.display = 'none';
        const num = document.getElementById(`step-${i}-num`);
        if(num) num.style.background = '#ccc';
    }
    document.getElementById(`step-${step}-content`).style.display = 'block';
    const num = document.getElementById(`step-${step}-num`);
    if(num) num.style.background = 'var(--ruby-pink)';
}

function selectPayment(el) {
    document.querySelectorAll('.payment-label').forEach(l => {
        l.style.borderColor = '#eee';
        l.style.background = 'white';
    });
    el.style.borderColor = 'var(--ruby-pink)';
    el.style.background = 'var(--soft-pink)';
}

function placeOrder() {
    const btn = event.currentTarget;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Processing Payment...';
    btn.disabled = true;
    
    setTimeout(() => {
        alert("Order Placed Successfully! Your items will arrive soon.\nOrder ID: #AM-" + Math.floor(Math.random() * 90000 + 10000));
        localStorage.removeItem('cart');
        window.location.href = '/';
    }, 2000);
}
</script>

<%- include('footer') %>
