<%- include('header') %>

<div class="container mt-40">
    <div style="display:flex; gap:60px;">
        <div style="flex:1;">
            <div style="position:relative; background:white; border-radius:20px; padding:40px; box-shadow:var(--shadow); display:flex; align-items:center; justify-content:center; height:500px;">
                <img src="/static/img/products/<%= product.category.toLowerCase().replace(/ & /g, '_').replace(/ /g, '_') %>/<%= product.img %>" style="max-width:100%; max-height:100%; object-fit:contain;">
                <div style="position:absolute; bottom:20px; right:20px; background:var(--white); width:50px; height:50px; border-radius:50%; display:flex; align-items:center; justify-content:center; box-shadow:0 5px 15px rgba(0,0,0,0.1); cursor:pointer;">
                    <i class="fas fa-sync-alt" style="color:var(--ruby-pink); font-size:1.5rem;"></i>
                </div>
            </div>
        </div>

        <div style="flex:1;">
            <span style="background:var(--accent-pink); color:var(--ruby-pink); padding:4px 12px; border-radius:20px; font-size:0.8rem; font-weight:700;">BESTSELLER</span>
            <h1 style="font-size:2.5rem; margin:10px 0;"><%= product.name %></h1>
            <p style="color:var(--light-text); margin-bottom:20px;"><%= product.category %></p>
            
            <div style="background:#FFF5F7; border-left:4px solid var(--ruby-pink); padding:10px 20px; border-radius:0 8px 8px 0; margin-bottom:30px;">
                <i class="fas fa-fire" style="color:var(--ruby-pink);"></i>
                <span style="font-size:0.9rem; font-weight:600;">542 people bought this in the last 24 hours</span>
            </div>

            <div style="background:white; padding:30px; border-radius:20px; box-shadow:var(--shadow); margin-bottom:30px;">
                <div style="display:flex; align-items:baseline; gap:15px; margin-bottom:10px;">
                    <span style="font-size:2.5rem; color:var(--ruby-pink); font-weight:900;">₹<%= product.price %></span>
                    <span style="color:var(--light-text); text-decoration:line-through; font-size:1.2rem;">MRP ₹<%= product.old_price %></span>
                    <span style="color:#28a745; font-weight:700;">(<%= Math.round((product.old_price - product.price) / product.old_price * 100) %>% OFF)</span>
                </div>
            </div>

            <div style="display:flex; gap:20px;">
                <button class="btn btn-primary" style="flex:1; padding:18px;" onclick="addToCart(this, '<%= product.id %>', '<%= product.name %>', <%= product.price %>, '<%= product.img %>', '<%= product.category %>')">ADD TO BAG</button>
                <button class="btn" style="flex:1; border:2px solid var(--ruby-pink); color:var(--ruby-pink);">WISHLIST</button>
            </div>
        </div>
    </div>
</div>

<%- include('footer') %>
