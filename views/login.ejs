<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login | ApexMarket</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&family=Montserrat:wght@700;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/static/css/base.css">
    <style>
        body { background: linear-gradient(135deg, #FFF5F7 0%, #FFD1DC 100%); height: 100vh; display: flex; align-items: center; justify-content: center; }
        .login-card { background: white; padding: 50px; border-radius: 30px; box-shadow: 0 20px 50px rgba(255, 105, 180, 0.2); width: 450px; text-align: center; }
    </style>
</head>
<body>
    <div class="login-card">
        <div class="logo" style="justify-content:center; margin-bottom:20px;">
            <i class="fas fa-gem"></i> ApexMarket
        </div>
        <h2 style="margin-bottom:30px;">Welcome Back</h2>
        
        <div style="margin-bottom:20px; text-align:left;">
            <label style="display:block; font-size:0.8rem; font-weight:600; margin-bottom:5px;">Mobile / Email / User ID</label>
            <input type="text" id="login-input" placeholder="0123456789" style="width:100%; padding:12px; border:2px solid var(--accent-pink); border-radius:12px; outline:none;">
        </div>

        <div id="otp-area" style="display:none; margin-top:20px;">
            <p style="font-size:0.8rem; margin-bottom:10px;">Auto-detected OTP: <b>0123</b></p>
            <div style="display:flex; gap:10px; justify-content:center;">
                <input type="text" value="0" style="width:40px; text-align:center;">
                <input type="text" value="1" style="width:40px; text-align:center;">
                <input type="text" value="2" style="width:40px; text-align:center;">
                <input type="text" value="3" style="width:40px; text-align:center;">
            </div>
        </div>

        <button class="btn btn-primary" id="login-btn" style="width:100%; margin-top:20px;" onclick="doLogin()">Continue</button>
    </div>

    <script>
        let step = 1;
        function doLogin() {
            if (step === 1) {
                const btn = document.getElementById('login-btn');
                btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Requesting OTP...';
                btn.disabled = true;
                
                setTimeout(() => {
                    document.getElementById('otp-area').style.display = 'block';
                    btn.innerHTML = 'Verifying OTP...';
                    step = 2;
                    
                    // Auto-verify after 1.5s
                    setTimeout(() => {
                        localStorage.setItem('apex_auth', 'true');
                        btn.innerHTML = '<i class="fas fa-check"></i> Success!';
                        btn.style.background = '#28a745';
                        setTimeout(() => {
                            window.location.href = '/';
                        }, 800);
                    }, 1500);
                }, 1000);
            }
        }
    </script>
</body>
</html>
